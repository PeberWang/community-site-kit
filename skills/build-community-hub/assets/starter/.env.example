# Copy this file to .env. Keep real values out of Git.
SESSION_SECRET=change-me-to-a-long-random-string
ENVIRONMENT=development
SESSION_COOKIE_SECURE=false

# OpenAI-compatible model API. Leave blank to run without AI drafting.
LLM_API_KEY=
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name

# Optional OCR API. Leave blank to skip OCR.
GLM_API_KEY=
GLM_OCR_URL=https://ocr.example.com/v1/layout_parsing

# local_stub needs no cloud account. aliyun_oss is the included production adapter.
CLOUD_DRIVE_BACKEND=local_stub
CLOUD_STUB_DIR=./data/oss_stub
OSS_BUCKET=
OSS_ENDPOINT=https://oss-region.example.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PRESIGNED_TTL=3600
OSS_AUTH_MODE=access_key
OSS_ROLE_ARN=
OSS_ROLE_SESSION_NAME=community-site
OSS_PUBLIC_BASE=
OSS_CDN_DOMAIN=

WEB_HOST=127.0.0.1
WEB_PORT=8790
SITE_NAME=共同生长知识站
COMMUNITY_CONFIG=./config/community.json
DB_DIR=./data/db
GUIDES_DIR=./data/guides
UPLOADS_DIR=./data/uploads
SUMMARY_DIR=./data/summaries
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
